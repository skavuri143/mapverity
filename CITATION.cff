license: Apache-2.0
repository-code: "https://github.com/YOUR-GITHUB-USER/mapverity"
keywords:
  - ETL testing
  - data validation
  - source-to-target mapping
  - mutation testing
  - test prioritization
  - defect prediction
  - explainable AI
  - healthcare data
  - insurance data
